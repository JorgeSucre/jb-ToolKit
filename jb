#!/bin/bash

set -Eeuo pipefail

BASE_DIR="${BASE_DIR:-$(cd "$(dirname "$0")" && pwd)}"
source "$BASE_DIR/core/utils.sh"


init_session
set_session_module "Launcher"
install_session_traps

# asegurar permisos
chmod +x "$BASE_DIR/core/"*.sh 2>/dev/null || true

run_script() {
    local label="$1"
    local script="$2"
    local exit_code

    echo "$label"
    echo ""

    if [[ -f "$script" ]]; then
        session_write INFO "Launching $(basename "$script")"
        if bash "$script"; then
            session_write EXIT "$(basename "$script") completed with exit code 0"
        else
            exit_code=$?
            session_write ERROR "$(basename "$script") failed with exit code $exit_code"
            echo "❌ Error ejecutando $(basename "$script")"
        fi
    else
        session_write ERROR "Script not found: $script"
        echo "❌ $(basename "$script") no encontrado"
    fi
}

# =========================
# Función pausa estándar
# =========================
pause() {
    echo ""
    read -r -p "Presiona Enter para volver al menú..." _ || true
}

trap 'echo ""; echo "👋 Saliendo..."; exit 0' INT

# =========================
# Loop principal robusto
# =========================
while true; do
    clear

    echo "=============================="
    echo "   JB TOOLKIT 🍺"
    echo "=============================="
    echo "1) Initial Setup"
    echo "2) Diagnostics (Scan System)"
    echo "3) Maintenance (Fix Issues)"
    echo "4) Deployment (Prepare Mac)"
    echo "5) Report (Export Results)"
    echo "6) Exit"
    echo ""

    read -r -p "Option: " opt || { echo ""; echo "👋 Saliendo..."; exit 0; }
    opt="$(echo "$opt" | xargs)"  # trim spaces
    echo ""

    [[ -z "$opt" ]] && continue

    case "$opt" in
        1)
            run_script "👉 Ejecutando setup..." "$BASE_DIR/core/bootstrap.sh"
            pause
            ;;
        2)
            run_script "🔍 Ejecutando diagnóstico..." "$BASE_DIR/core/diagnostics.sh"
            pause
            ;;
        3)
            run_script "🛠️ Ejecutando mantenimiento..." "$BASE_DIR/core/maintenance.sh"
            pause
            ;;
        4)
            run_script "🚀 Ejecutando deployment..." "$BASE_DIR/core/deployment.sh"
            pause
            ;;
        5)
            run_script "📊 Generando reporte..." "$BASE_DIR/core/report.sh"
            pause
            ;;
        6)
            echo "👋 Saliendo..."
            exit 0
            ;;
        *)
            echo "❌ Opción inválida. Selecciona 1–6."
            sleep 1
            ;;
    esac

done
